governed_supply_chain_resilience:
  target: dev
  outputs:
    dev:
      type: databricks
      method: http
      catalog: "{{ env_var('DATABRICKS_CATALOG_DEV', 'workspace') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA_DEV', 'analytics') }}"
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4

    prod:
      type: databricks
      method: http
      catalog: "{{ env_var('DATABRICKS_CATALOG_PROD', 'workspace') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA_PROD', 'analytics') }}"
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 8
